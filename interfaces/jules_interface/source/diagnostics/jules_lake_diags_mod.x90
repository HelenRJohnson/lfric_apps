!> @brief Processes diagnostics for jules_extra_alg

module jules_lake_diags_mod

  use field_mod,                 only: field_type
  use io_config_mod,             only: subroutine_timers
  use timer_mod,                 only: timer

  implicit none

  private

  public :: output_diags_for_jules_lake

contains

  !> @brief Output diagnostics from jules_extra_alg
  !> @param[in]     lake_t_mxl_gb            Lake mixed layer temperatue
  !> @param[in]     lake_t_mean_gb           Lake mean temperature
  !> @param[in]     lake_t_ice_gb            Temperature at upper boundary of lake
  !> @param[in]     lake_h_mxl_gb            Lake mixed layer thickness
  !> @param[in]     lake_h_ice_gb            Lake ice thickness
  !> @param[in]     lake_shape_factor_gb     Lake thermocline shape factor
  !> @param[in]     lake_g_dt_gb             Lake ground heat flux over delta T

  subroutine output_diags_for_jules_lake(lake_t_mxl_gb, lake_t_mean_gb,        &
                                     lake_t_ice_gb, lake_h_mxl_gb,             &
                                     lake_h_ice_gb, lake_shape_factor_gb,      &
                                     lake_g_dt_gb)

    implicit none

    ! Prognostic fields to output
    type( field_type ), intent(in)    :: lake_t_mxl_gb, lake_t_mean_gb,        &
                                         lake_t_ice_gb, lake_h_mxl_gb,         &
                                         lake_h_ice_gb, lake_shape_factor_gb,  &
                                         lake_g_dt_gb

    if ( subroutine_timers ) call timer("jules_lake_diags")

    ! Prognostic fields
    call lake_t_mxl_gb%write_field('surface__lake_t_mxl_gb')
    call lake_t_mean_gb%write_field('surface__lake_t_mean_gb')
    call lake_t_ice_gb%write_field('surface__lake_t_ice_gb')
    call lake_h_mxl_gb%write_field('surface__lake_h_mxl_gb')
    call lake_h_ice_gb%write_field('surface__lake_h_ice_gb')
    call lake_shape_factor_gb%write_field('surface__lake_shape_factor_gb')
    call lake_g_dt_gb%write_field('surface__lake_g_dt_gb')

    if ( subroutine_timers ) call timer("jules_lake_diags")

  end subroutine output_diags_for_jules_lake
end module jules_lake_diags_mod
